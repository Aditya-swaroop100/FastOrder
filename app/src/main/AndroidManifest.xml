<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Firebase (Auth, Firestore, Crashlytics) and Firebase AI Logic / Gemini calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Firebase SDKs and the app detect connectivity changes (offline cart, retry logic) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FastOrderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastOrder">

        <!--
          Sentry ships a ContentProvider that auto-initialises the SDK from
          manifest meta-data before Application.onCreate(). It is turned off
          here so FastOrderApplication can initialise it in code instead: the
          free-plan quota settings (tracing, replay and attachments all off)
          must be in place for the very first event, and the DSN comes from
          BuildConfig rather than being hard-coded into this file.
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FastOrder.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

