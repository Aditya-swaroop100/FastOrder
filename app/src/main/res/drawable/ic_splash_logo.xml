<?xml version="1.0" encoding="utf-8"?>
<!--
  FastOrder splash logo: a shopping bag with a lightning bolt ("fast" delivery).

  Sized as a 108x108 vector with the artwork constrained to the centre ~66%,
  which is the safe zone the Android 12+ splash screen masks to. Anything
  outside that circle gets clipped on newer devices.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bag handle (drawn first so the body overlaps its ends) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46,44 v-5 a8,8 0 0 1 16,0 v5"
        android:strokeColor="@color/brand_primary"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- Bag body -->
    <path
        android:fillColor="@color/brand_primary"
        android:pathData="M35,41 h38 a3,3 0 0 1 3,3 v30 a6,6 0 0 1 -6,6 h-32 a6,6 0 0 1 -6,-6 v-30 a3,3 0 0 1 3,-3 z" />

    <!-- Lightning bolt knocked out of the bag -->
    <path
        android:fillColor="@color/splash_background"
        android:pathData="M58,48 L47,63 L53,63 L50,76 L61,60 L55,60 Z" />
</vector>

