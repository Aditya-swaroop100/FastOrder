*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
.gradle/
build/
**/build/
bin/
gen/
out/
release/
captures/

# ---------------------------------------------------------------
# Local / machine-specific config - never commit
# ---------------------------------------------------------------
local.properties
*.iml

# ---------------------------------------------------------------
# Signing material - NEVER commit these
# ---------------------------------------------------------------
*.jks
*.keystore
keystore.properties
signing.properties

# ---------------------------------------------------------------
# IDE
# ---------------------------------------------------------------
.idea/

# ---------------------------------------------------------------
# Kotlin / native build
# ---------------------------------------------------------------
.kotlin/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------
# Firebase
#
# NOTE: app/google-services.json is intentionally committed. It contains
# identifiers (project ID, app ID, API key), not credentials - the same values
# ship inside every published APK and can be extracted from it. Access is
# controlled by Firestore Security Rules, App Check, and API key restrictions,
# not by keeping this file private. Uncomment the line below if you would
# rather keep it out of the repo and inject it in CI instead.
# ---------------------------------------------------------------
# app/google-services.json
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log

# ---------------------------------------------------------------
# Lint
# ---------------------------------------------------------------
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint/reports/

# ---------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log

# ---------------------------------------------------------------
# Sentry
#
# The DSN is NOT secret (it ships in every APK and only grants permission
# to write events), so it lives in local.properties purely to keep it
# account-specific rather than hard-coded. Auth tokens ARE secret - they
# grant org-wide upload rights - so never commit sentry.properties.
# ---------------------------------------------------------------
sentry-wizard
sentry.properties
.sentryclirc
